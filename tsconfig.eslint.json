{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/vitest*.ts",
    "tools/*/src/**/*.ts",
    "tools/*/test/**/*.ts",
    "tools/*/vitest.config.ts",
    "services/**/*.ts"
  ]
}
