{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/vitest.config.ts",
    "tools/*/src/**/*.ts",
    "tools/*/vitest.config.ts",
    "services/**/*.ts",
    "apps/**/*.ts"
  ]
}
