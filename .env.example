# Скопируйте в .env и заполните пустые значения: cp .env.example .env
# У секретов нет значений по умолчанию, без них не стартуют база и шлюз.
# Остальные строки повторяют умолчания из схем окружения (services/*/src/config/env.ts,
# tools/seed, packages/db): их можно удалить, поведение не изменится. Исключения два:
# POSTGRES_USER умолчания не имеет, а пустой MODBUS_HOST_OVERRIDE меняет адрес приборов.
# Файл целиком отдаётся каждому контейнеру (env_file), поэтому переменные со своим значением
# для каждого сервиса оставлены закомментированными: их задаёт compose или командная строка.

POSTGRES_USER=fieldstream
POSTGRES_PASSWORD=

# Роли базы: владелец схемы (migrator), писатель телеметрии (stream-processor), читатель (api-gateway).
FS_MIGRATOR_PASSWORD=
FS_INGEST_PASSWORD=
FS_API_PASSWORD=

# База: имя, порт и направление миграций (up накатывает, down откатывает).
POSTGRES_DB=fieldstream
DATABASE_PORT=5432
MIGRATE_DIRECTION=up
# Адрес базы: у мигратора и засева умолчание timescaledb, у процессора и шлюза localhost.
# У мигратора в compose нет своего окружения, он держится на умолчании, поэтому здесь
# адрес лучше не фиксировать: значение из файла досталось бы и ему.
# DATABASE_HOST=localhost

# Засев истории: глубина в сутках (1..90) и сжатие старых кусков гипертаблицы.
SEED_DAYS=7
SEED_COMPRESS=on

# Стенд приборов: сид физики, ускорение времени (1..60) и тайминги линии RS-485.
SIM_HOST=0.0.0.0
SIM_HTTP_PORT=8090
SIM_SEED=fieldstream
SIM_SPEED=1
SIM_TURNAROUND_MS=5
# Случайная добавка к времени ответа: от неё у времени ответа длинный хвост, как у настоящих приборов.
SIM_TURNAROUND_JITTER_MS=40
SIM_BUS_TIMEOUT_MS=500
SIM_STALL_MS=5000

# Сборщик при запуске на хосте: брокер и адрес шлюзов. В compose оба значения переопределяются.
KAFKA_BROKERS=localhost:29092
MODBUS_HOST_OVERRIDE=127.0.0.1
COLLECTOR_HOST=0.0.0.0
COLLECTOR_HTTP_PORT=8091
# Линии этого сборщика через запятую (например L1,L3), пусто значит все линии стенда.
COLLECTOR_LINES=
# Буфер публикации: сколько сообщений сборщик держит, пока брокер недоступен.
COLLECTOR_BUFFER_CAPACITY=2000

# Процессор: адрес, такт отчёта о здоровье и обновление правил алармов из базы.
PROCESSOR_HOST=0.0.0.0
PROCESSOR_HTTP_PORT=8092
HEALTH_INTERVAL_MS=5000
ALARM_RULES_REFRESH_MS=10000
# Повторная подача кадров из очереди недоставленных: включение и такт опроса очереди.
DLQ_REDRIVE=on
DLQ_REDRIVE_POLL_MS=1000
# Перепрогон уставок по сырым кадрам: включение, опрос очереди прогонов, пульс идущего прогона,
# срок без пульса, после которого прогон считается брошенным, и предел времени одного прогона.
# Срок протухания должен вмещать хотя бы три пульса, иначе процессор не стартует.
REPLAY=on
REPLAY_POLL_MS=2000
REPLAY_HEARTBEAT_MS=2000
REPLAY_STALE_MS=60000
REPLAY_MAX_MS=600000
# Имя экземпляра процессора, если их несколько. Без него берётся имя хоста с номером процесса.
# PROCESSOR_INSTANCE_ID=

# Шлюз интерфейса. На стенде браузер ходит через nginx на 8080, то есть в один origin,
# и список CORS_ORIGINS там не участвует вовсе: он нужен только дев-серверу vite на 5173.
GATEWAY_HOST=0.0.0.0
GATEWAY_HTTP_PORT=8093
CORS_ORIGINS=http://localhost:5173
# Имя экземпляра шлюза, если их несколько. Без него берётся имя хоста с номером процесса.
# GATEWAY_INSTANCE_ID=

# Секрет подписи токенов, не короче 32 символов: без него не стартуют шлюз и интерфейс.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Пароль учётных записей стенда viewer/engineer/admin@fieldstream.local.
DEMO_PASSWORD=fieldstream

# Сроки жизни токенов и окно повтора обновления: ответ мог потеряться по дороге, это не повод разлогинивать.
ACCESS_TTL_MS=600000
REFRESH_TTL_MS=2592000000
REFRESH_REUSE_WINDOW_MS=60000
# Ограничитель входов: ведро почты, ведро адреса (шире, за адресом бывает целая площадка) и такт пополнения.
LOGIN_ATTEMPTS=10
LOGIN_IP_ATTEMPTS=50
LOGIN_REFILL_MS=30000
# Флаг secure у cookie: включать там, где интерфейс отдаётся по https.
COOKIE_SECURE=false
# Доверять заголовкам обратного прокси: за nginx без этого все входы попадают в одно ведро ограничителя.
# В compose шлюзу выставлено on, здесь умолчание для запуска без прокси.
TRUST_PROXY=off

# Живой канал событий: такт пустых кадров, чтобы соединение не закрыли, и глубина кольца для дозагрузки после разрыва.
SSE_PING_MS=20000
SSE_RING_SIZE=5000
# Мост из брокера в живой канал. Выключается там, где шлюз поднимают без Kafka.
SSE_BRIDGE=on
# Очередь исходящих: рассылка команд в брокер, такт и размер пачки.
OUTBOX_RELAY=on
OUTBOX_POLL_MS=500
OUTBOX_BATCH=100
# Срок жизни команды: применять её позже смысла нет, обстановка уже другая.
COMMAND_TTL_MS=60000
# Замер задержек конвейера: включение и такт опроса.
PIPELINE_SAMPLER=on
PIPELINE_POLL_MS=2000
# Состояние линий сборщика в интерфейсе: читается из компактируемого топика.
COLLECTOR_STATUS=on
# Сколько перепрогон ждёт процессора: дольше значит, что перепрогон выключен или процессор не запущен.
REPLAY_QUEUE_TIMEOUT_MS=60000
# Такт опроса шага сценария на стенде.
SCENARIO_POLL_MS=1000
# Адрес стенда приборов для шлюза. Без него ручки стенда отвечают «симулятор не подключён».
# В compose шлюзу выставлен http://device-sim:8090.
# SIM_URL=http://localhost:8090
# Своя папка со сценариями вместо встроенной.
# SCENARIOS_DIR=

LOG_LEVEL=info

# Прогон сценариев и e2e этот файл не читает: адрес стенда и учётная запись задаются
# в командной строке, см. docs/STAND.md.
