# Скопируйте в .env и заполните пустые значения: cp .env.example .env
# У секретов нет значений по умолчанию, без них не стартуют база и шлюз.

POSTGRES_USER=fieldstream
POSTGRES_PASSWORD=

# Роли базы: владелец схемы (migrator), писатель телеметрии (stream-processor), читатель (api-gateway).
FS_MIGRATOR_PASSWORD=
FS_INGEST_PASSWORD=
FS_API_PASSWORD=

# Стенд приборов: сид физики, ускорение времени (1..60) и тайминги линии RS-485.
SIM_SEED=fieldstream
SIM_SPEED=1
SIM_TURNAROUND_MS=5
SIM_BUS_TIMEOUT_MS=500
SIM_STALL_MS=5000

# Сборщик при запуске на хосте: брокер и адрес шлюзов. В compose оба значения переопределяются.
KAFKA_BROKERS=localhost:29092
MODBUS_HOST_OVERRIDE=127.0.0.1
COLLECTOR_HTTP_PORT=8091

LOG_LEVEL=info

# Шлюз интерфейса. На стенде браузер ходит через nginx на 8080, то есть в один origin,
# и список CORS_ORIGINS там не участвует вовсе: он нужен только дев-серверу vite на 5173.
GATEWAY_HTTP_PORT=8093
CORS_ORIGINS=http://localhost:5173

# Секрет подписи токенов, не короче 32 символов: без него не стартуют шлюз и интерфейс.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Пароль учётных записей стенда viewer/engineer/admin@fieldstream.local.
DEMO_PASSWORD=fieldstream
