{
  "name": "@fieldstream/api-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:watch": "tsc --build --watch --preserveWatchOutput",
    "dev": "node --watch-path=dist --env-file-if-exists=../../.env dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fieldstream/contracts": "workspace:*",
    "@fieldstream/db": "workspace:*",
    "@fieldstream/device-profiles": "workspace:*",
    "@fieldstream/domain": "workspace:*",
    "@fieldstream/kafka": "workspace:*",
    "@fieldstream/nest-common": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@prometheus-io/client": "^0.16.1",
    "fastify": "^5.12.4",
    "jose": "^6.2.12",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.1.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
