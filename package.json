{
  "name": "fieldstream",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev build:watch",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch": "depcruise packages services apps --config .dependency-cruiser.cjs",
    "topics:gen": "pnpm --filter @fieldstream/contracts run build && pnpm --filter @fieldstream/topic-matrix run gen",
    "infra:up": "docker compose -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.dev.yml up -d timescaledb kafka kafka-init migrator",
    "infra:down": "docker compose -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.dev.yml down",
    "stack:up": "docker compose -f infra/compose/docker-compose.yml up -d --build",
    "stack:seed": "docker compose -f infra/compose/docker-compose.yml run --rm seed",
    "stack:down": "docker compose -f infra/compose/docker-compose.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "dependency-cruiser": "^16.5.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "pnpm": {
    "overrides": {
      "fastify": "^5.12.4"
    }
  },
  "license": "MIT"
}
